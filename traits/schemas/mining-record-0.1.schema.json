{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heritagent.dev/schemas/mining/mining-record-0.1.json",
  "title": "Trait Miner v0.1 — mining audit record",
  "description": "Immutable audit artifact for ONE teacher call. This is MINING evidence, not CIG evidence: no causal claims, no cig_record.",
  "type": "object",
  "required": [
    "record",
    "schema_version",
    "mining_record_id",
    "success_trajectory_ids",
    "failure_trajectory_ids",
    "task_families",
    "evidence_sha256",
    "prompt_template_sha256",
    "output_schema_sha256",
    "mining_seed",
    "generation_settings",
    "model_metadata",
    "raw_structured_response",
    "accepted_proposals",
    "rejected",
    "discovery_order",
    "raw_teacher_text"
  ],
  "properties": {
    "record": {
      "const": "mining"
    },
    "schema_version": {
      "const": "0.1"
    },
    "mining_record_id": {
      "type": "string",
      "pattern": "^MR-[0-9a-f]{12}$"
    },
    "success_trajectory_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "failure_trajectory_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "task_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_template_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mining_seed": {
      "type": "integer"
    },
    "generation_settings": {
      "type": "object",
      "required": [
        "temperature",
        "max_tokens"
      ],
      "properties": {
        "temperature": {
          "type": "number"
        },
        "max_tokens": {
          "type": "integer"
        },
        "seed": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "model_metadata": {
      "type": "object"
    },
    "raw_structured_response": {
      "type": [
        "object",
        "null"
      ],
      "description": "parsed structured response; null when the teacher output was malformed"
    },
    "accepted_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gene_id",
          "version",
          "discovery_order"
        ],
        "properties": {
          "gene_id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "discovery_order": {
            "type": "integer",
            "minimum": 0
          },
          "estimated_generality": {
            "type": "number"
          },
          "source_trajectory_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "enum": [
              "malformed_output",
              "invalid_applicability",
              "exact_duplicate",
              "outside_cap"
            ]
          },
          "proposal_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "discovery_order": {
      "type": "array",
      "description": "accepted proposal gene_ids in discovery order (pre-ranking)",
      "items": {
        "type": "string"
      }
    },
    "raw_teacher_text": {
      "type": [
        "string",
        "null"
      ],
      "description": "exact raw teacher output when the call was malformed (audit); null for valid calls"
    }
  },
  "additionalProperties": false
}
